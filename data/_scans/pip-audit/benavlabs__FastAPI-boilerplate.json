lns": []}, {"name": "rich", "version": "15.0.0", "vulns": []}, {"name": "rich-toolkit", "version": "0.19.7", "vulns": []}, {"name": "rignore", "version": "0.7.6", "vulns": []}, {"name": "ruff", "version": "0.15.12", "vulns": []}, {"name": "sentry-sdk", "version": "2.59.0", "vulns": []}, {"name": "shellingham", "version": "1.5.4", "vulns": []}, {"name": "sqladmin", "version": "0.26.0", "vulns": []}, {"name": "starlette", "version": "1.0.0", "vulns": [{"id": "PYSEC-2026-249", "fix_versions": ["1.3.1"], "aliases": ["CVE-2026-54283", "GHSA-82w8-qh3p-5jfq"], "description": "Starlette: request.form() limits silently ignored for application/x-www-form-urlencoded enable DoS"}, {"id": "PYSEC-2026-161", "fix_versions": ["1.0.1"], "aliases": ["CVE-2026-48710", "X41-2026-002", "GHSA-86qp-5c8j-p5mr"], "description": "Starlette has missing Host header validation that poisons request.url.path, bypassing path-based security checks"}, {"id": "PYSEC-2026-248", "fix_versions": ["1.3.0"], "aliases": ["CVE-2026-54282", "GHSA-jp82-jpqv-5vv3"], "description": "Starlette: Unvalidated request path concatenated into authority poisons request.url.hostname"}, {"id": "PYSEC-2026-161", "fix_versions": ["1.0.1"], "aliases": ["CVE-2026-48710", "GHSA-86qp-5c8j-p5mr", "X41-2026-002"], "description": "BadHost: Missing Host header validation poisons request.url.path, bypassing path-based security checks"}, {"id": "PYSEC-2026-248", "fix_versions": ["1.3.0"], "aliases": ["CVE-2026-54282", "GHSA-jp82-jpqv-5vv3"], "description": "Starlette is a lightweight ASGI framework/toolkit. Prior to 1.3.0, the HTTP request path is not validated before being used to reconstruct request.url. Because request.url is rebuilt by concatenating {scheme}://{host}{path} and re-parsing the result, a path that does not begin with / (for example @google.com) moves the authority boundary during re-parsing, so request.url.hostname and request.url.netloc become attacker-controlled. Code that reads request.url.hostname (rather than the Host header or scope) can therefore be misled into trusting an attacker-supplied host. This vulnerability is fixed in 1.3.0."}, {"id": "PYSEC-2026-249", "fix_versions": ["1.3.1"], "aliases": ["CVE-2026-54283", "GHSA-82w8-qh3p-5jfq"], "description": "Starlette is a lightweight ASGI framework/toolkit. From 0.4.1 until 1.3.1, request.form() accepts max_fields and max_part_size to bound resource consumption while parsing form data. These limits are enforced for multipart/form-data, but silently ignored for application/x-www-form-urlencoded. An unauthenticated attacker can therefore send a urlencoded body with an arbitrarily large number of fields or an arbitrarily large field, even when the application configured limits it believed would apply. This vulnerability is fixed in 1.3.1."}, {"id": "CVE-2026-48818", "fix_versions": ["1.1.0"], "aliases": ["GHSA-wqp7-x3pw-xc5r"], "description": "Starlette: SSRF and NTLM credential theft via UNC paths in StaticFiles on Windows"}, {"id": "CVE-2026-48817", "fix_versions": ["1.1.0"], "aliases": ["GHSA-x746-7m8f-x49c"], "description": "Starlette: Arbitrary HTTP method dispatched to `HTTPEndpoint` attributes via `getattr`"}]}, {"name": "wtforms", "version": "3.1.2", "vulns": []}, {"name": "taskiq", "version": "0.12.4", "vulns": []}, {"name": "taskiq-dependencies", "version": "1.5.7", "vulns": []}, {"name": "taskiq-aio-pika", "version": "0.6.0", "vulns": []}, {"name": "taskiq-redis", "version": "1.2.2", "vulns": []}, {"name": "testcontainers", "version": "4.14.2", "vulns": []}, {"name": "typer", "version": "0.25.1", "vulns": []}, {"name": "typing-extensions", "version": "4.15.0", "vulns": []}, {"name": "typing-inspection", "version": "0.4.2", "vulns": []}, {"name": "tzdata", "version": "2026.2", "vulns": []}, {"name": "ua-parser", "version": "1.0.2", "vulns": []}, {"name": "ua-parser-builtins", "version": "202605", "vulns": []}, {"name": "user-agents", "version": "2.2.0", "vulns": []}, {"name": "uvicorn", "version": "0.46.0", "vuln